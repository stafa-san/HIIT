# H.I.T.T. environment — copy to .env.local (never commit .env.local; this repo is public).
#
# With NO Firebase values the app runs in demo mode: a generated season lives
# in the browser (localStorage). Fill these in to sync every device through
# Firestore in real time.

# --- Firebase web app (Firebase Console → Project settings → Your apps → Web) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firestore document under teams/ this deployment uses.
NEXT_PUBLIC_HITT_TEAM_ID=demo-varsity

# Force demo mode even when Firebase is configured (optional): demo
# NEXT_PUBLIC_HITT_DATA_MODE=demo

# Use local emulators (`npm run emulators`) instead of the real project.
# NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true

# --- Server only (Vercel → Settings → Environment Variables) ---
# Service-account JSON on ONE line (Project settings → Service accounts →
# Generate new private key). Needed by `npm run seed` and POST /api/ingest.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Shared secret for POST /api/ingest (Wi-Fi sensors / gateway scripts).
# Generate one: openssl rand -hex 24
HITT_INGEST_KEY=
