{
  "name": "hitt",
  "version": "0.1.0",
  "private": true,
  "description": "H.I.T.T. — Helmet-Integrated TBI Tracker: sideline dashboard, coach alerts, sensor fleet and return-to-play tracking",
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "seed": "tsx --env-file=.env.local scripts/seed-firestore.ts",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-hitt",
    "verify:firestore": "firebase emulators:exec --only firestore,auth --project demo-hitt 'tsx scripts/verify-firestore.ts'",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^12.7.0",
    "lucide-react": "^1.69.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
