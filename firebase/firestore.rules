rules_version = '2';

// H.I.T.T. — hackathon rules: any signed-in client (the app signs in
// anonymously) can read and write team data. Before real athlete data goes in,
// replace anonymous auth with staff accounts and scope access per team.
service cloud.firestore {
  match /databases/{database}/documents {
    match /teams/{teamId} {
      allow read, write: if request.auth != null;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null
          && collection in ['players', 'sensors', 'sessions', 'impacts'];
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
